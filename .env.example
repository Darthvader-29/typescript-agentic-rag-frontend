# Backend API base URL (must include the /api suffix).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Feature flags — keep "false" until the matching backend phase ships.
# streaming  -> backend P6 SSE        (consumed M2/M9 — DEFAULTS ON; see note below)
# auth       -> backend P3/P6 JWT     (consumed M6 — guest-by-default + register/login/upgrade)
# byok       -> backend P4 BYOK       (consumed M7 — DEFAULTS ON; see note below)
# presigned  -> backend P5 S3         (consumed M8)
# rich       -> backend P6 component  (consumed M10 — rich-output rendering)
#
# NEXT_PUBLIC_FEATURE_AUTH=true requires a reachable backend with /api/auth/{guest,login,
# register,upgrade,refresh} live AND the frontend origin in the backend CORS allow-list.
# With auth ON, first load silently mints a guest (frictionless chat); "Register to save
# your keys" upgrades the same user_id. Auth is NOT a hard wall — chat degrades to the
# anonymous path if the guest endpoint is unavailable.
#
# NEXT_PUBLIC_FEATURE_STREAMING defaults ON as of M9: the live backend P6 SSE path. Set it
# to false to fall back to the blocking /api/chat path.
#
# NEXT_PUBLIC_FEATURE_BYOK defaults ON as of M7: it exposes the Settings route, the
# provider/model picker, the free-tier disclaimer (keyless users only), and the
# free_tier_exhausted upsell. Key management hits the Bearer-guarded /api/keys, so in
# practice it pairs with AUTH=true. To hide BYOK entirely, set it to false here — chat then
# falls back to the free tier with no picker/disclaimer/Settings entry.
NEXT_PUBLIC_FEATURE_STREAMING=true
NEXT_PUBLIC_FEATURE_AUTH=false
NEXT_PUBLIC_FEATURE_BYOK=true
NEXT_PUBLIC_FEATURE_PRESIGNED_UPLOAD=false
# M10: rich component rendering (table/chart/citation/code/callout/media). ON by default — the
# P6 `component` event is live. Set to "false" to fall back to a collapsed raw-JSON block.
NEXT_PUBLIC_FEATURE_RICH_COMPONENTS=true
